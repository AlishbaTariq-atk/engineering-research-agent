# Copy to .env and fill in what you need. Every field has a working
# default in research_agent/config.py, so the app runs with no .env at
# all if LLM_PROVIDER stays "ollama"; GROQ_API_KEY is only required
# when LLM_PROVIDER=groq.

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: unauthenticated GitHub API is capped at 60 requests/hour;
# a token raises that to 5000/hour. Needs no scopes for public repos.
GITHUB_TOKEN=

# Leave false on first run (models need to download). Once
# bge-small-en-v1.5 and the cross-encoder are cached locally
# (~/.cache/huggingface), set to true: it skips ~40s of redundant
# cache-verification requests to huggingface.co on every startup of the
# MCP server / index / agent commands - matters for a live demo where
# startup shouldn't depend on Hub latency.
HF_HUB_OFFLINE=false

LOG_LEVEL=INFO
