# Copy to .env and fill in what you need. Every field has a working
# default in research_agent/config.py, so the app runs with no .env at
# all if LLM_PROVIDER stays "ollama"; GROQ_API_KEY is only required
# when LLM_PROVIDER=groq.

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: unauthenticated GitHub API is capped at 60 requests/hour;
# a token raises that to 5000/hour. Needs no scopes for public repos.
GITHUB_TOKEN=

LOG_LEVEL=INFO
