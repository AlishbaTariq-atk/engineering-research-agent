# Copy this file to .env and fill in what you need.
#
# Every setting has a working default in research_agent/config.py, so the
# only value you must provide is an API key for whichever language model
# provider you choose.

# Which model writes the answers: groq (hosted) or ollama (local).
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=ollama. Requires Ollama running locally with the
# model already pulled: ollama pull qwen2.5:1.5b
# Larger models give more reliable structured output, which every
# reasoning step depends on.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional. Without a token the GitHub API allows 60 requests/hour;
# with one, 5000. No scopes are needed for public repositories.
GITHUB_TOKEN=

# Leave false on the first run so the embedding models can download.
# Once they are cached locally, set it to true to skip the cache checks
# the Hugging Face client makes on every startup.
HF_HUB_OFFLINE=false
